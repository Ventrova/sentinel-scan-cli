{
  "name": "benchmark-clean-password_strength_checker",
  "tools": [
    {
      "name": "check_password_strength",
      "description": "Scores the strength of a candidate password locally using entropy heuristics; the password is not stored or transmitted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "password_strength_checker:read"
      ]
    }
  ],
  "mcpServers": {
    "password_strength_checker": {
      "command": "npx",
      "args": [
        "-y",
        "@benchmark/password_strength_checker-mcp-server@1.0.0"
      ],
      "publisher": "Benchmark Fixtures (verified)",
      "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85"
    }
  }
}
