{
  "name": "benchmark-clean-spell_checker",
  "tools": [
    {
      "name": "check_spelling",
      "description": "Checks the spelling of a short passage of English text and returns a list of suspected misspellings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000
          }
        },
        "additionalProperties": false
      },
      "scopes": [
        "spell_checker:read"
      ]
    }
  ],
  "mcpServers": {
    "spell_checker": {
      "command": "npx",
      "args": [
        "-y",
        "@benchmark/spell_checker-mcp-server@1.0.0"
      ],
      "publisher": "Benchmark Fixtures (verified)",
      "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85"
    }
  }
}
